<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0F3D33">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Adibah">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2222%22 fill=%22%230F3D33%22/><text x=%2250%22 y=%2272%22 font-size=%2272%22 font-family=%22Georgia,serif%22 fill=%22white%22 text-anchor=%22middle%22>a</text></svg>">
<title>Adibah Accounting Ledger Application</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#0F3D33;--paper:#EEF3F0;--gold:#C8962E;--muted:#64756e}
*{box-sizing:border-box}
body{font-family:'Figtree',system-ui,sans-serif;background:var(--paper);color:#1b2b27;min-height:100vh;padding-bottom:env(safe-area-inset-bottom,0)}
.container{max-width:900px}
.logo{font-family:'DM Serif Display',Georgia,serif;font-size:clamp(4rem,16vw,7rem);color:var(--ink);line-height:1;display:inline-block;padding-bottom:.1em}
.logo:after{content:"";display:block;height:7px;margin-top:.08em;border-top:2px solid var(--gold);border-bottom:2px solid var(--gold)}
.subtitle{font-size:1.05rem;color:#4a5f58}
.panel{background:#fff;border:1px solid #cfdcd6;border-radius:12px;padding:1.4rem}
.btn-ink{background:var(--ink);color:#fff;border:0}
.btn-ink:hover,.btn-ink:focus{background:#0a2b24;color:#fff}
.form-control:focus,.form-select:focus{border-color:var(--ink);box-shadow:0 0 0 .2rem rgba(15,61,51,.18)}
.form-control,.form-select{min-height:46px}
.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
th{color:var(--ink);white-space:nowrap}
.hidden{display:none!important}
.status{font-size:.875rem}
.transaction-start td{border-top:2px solid #cfdcd6}
.transaction-credit td{color:#52645d;background:#fbfcfb}
.amount-cell{font-variant-numeric:tabular-nums}
#btnSave{min-width:150px}
.table-responsive{border-radius:12px}
.table{margin:0}
.table thead th{background:#f7faf8}
@media(max-width:575px){
 .container{padding-top:1.5rem!important}
 header{margin-bottom:1.75rem!important}
 .panel{padding:1rem}
 #btnSave{width:100%}
 #expenseForm .form-actions{display:block!important}
 #msg{display:block;margin-top:.65rem}
 .table{font-size:.82rem}
}
</style>
</head>
<body>
<div class="container py-5">
  <header class="text-center mb-5">
    <div class="logo">adibah</div>
    <p class="subtitle mt-3 mb-0">Adibah Accounting Ledger Application</p>
  </header>

  <section id="viewHome" class="panel mx-auto" style="max-width:460px">
    <label for="deptSelect" class="form-label fw-semibold">Choose your department</label>
    <select id="deptSelect" class="form-select form-select-lg">
      <option value="" selected disabled>Select department…</option>
      <option>Admin</option>
      <option>Sales</option>
      <option>Service/Technical</option>
      <option>Wing</option>
    </select>
    <div id="connectionStatus" class="small text-secondary mt-3">Connecting to ledger…</div>
  </section>

  <section id="viewExpense" class="hidden">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h2 class="h4 m-0">Expense entry <span class="text-secondary fw-normal">· <span id="deptName"></span></span></h2>
      <button id="btnBack" class="btn btn-outline-secondary btn-sm">Change department</button>
    </div>

    <form id="expenseForm" class="panel mb-4" autocomplete="off">
      <div class="row g-3">
        <div class="col-6">
          <label class="form-label" for="fDate">Date</label>
          <input type="date" id="fDate" class="form-control" required>
        </div>
        <div class="col-6">
          <label class="form-label" for="fAmount">Amount (RM)</label>
          <input type="number" inputmode="decimal" id="fAmount" class="form-control" min="0.01" max="99999999.99" step="0.01" placeholder="0.00" required>
        </div>
        <div class="col-12 col-sm-6">
          <label class="form-label" for="fAccount">Expense type (Debit)</label>
          <select id="fAccount" class="form-select" required>
            <option>Rent</option>
            <option>Salaries</option>
            <option>Utilities</option>
            <option>Transport</option>
            <option>Office Supplies</option>
            <option>Marketing</option>
            <option>Repairs &amp; Maintenance</option>
            <option>Other Expenses</option>
          </select>
        </div>
        <div class="col-12 col-sm-6">
          <label class="form-label" for="fPay">Paid using (Credit)</label>
          <select id="fPay" class="form-select" required>
            <option>Cash</option>
            <option>Bank</option>
            <option>Accounts Payable</option>
          </select>
        </div>
        <div class="col-12">
          <label class="form-label" for="fDesc">Description</label>
          <input type="text" id="fDesc" class="form-control" maxlength="200" placeholder="e.g. Paid electricity bill" required>
        </div>
      </div>
      <div class="d-flex align-items-center gap-3 mt-4 form-actions">
        <button type="submit" id="btnSave" class="btn btn-ink px-4">Save expense</button>
        <span id="msg" class="status" role="status" aria-live="polite"></span>
      </div>
    </form>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <div>
        <h3 class="h5 m-0">Recent journal lines</h3>
        <div class="small text-secondary">Each transaction is shown as Debit followed by Credit.</div>
      </div>
      <button id="btnCsv" type="button" class="btn btn-outline-success btn-sm">Download Excel (CSV)</button>
    </div>
    <div class="panel p-0 table-responsive">
      <table class="table table-sm align-middle">
        <thead><tr><th>Date</th><th>Description</th><th>Account</th><th class="num">Debit (RM)</th><th class="num">Credit (RM)</th></tr></thead>
        <tbody id="rows"><tr><td colspan="5" class="text-center text-secondary py-3">No entries yet.</td></tr></tbody>
      </table>
    </div>
  </section>
</div>

<script>
// Paste the deployed Google Apps Script Web App URL here. It must end in /exec.
const API_URL = "PASTE_YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE";
const MAX_AMOUNT = 99999999.99;
const $ = id => document.getElementById(id);
let dept = "";

const esc = value => String(value ?? "").replace(/[&<>"']/g, c => ({
  "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
}[c]));
const money = value => Number(value || 0).toLocaleString("en-MY", {
  minimumFractionDigits:2, maximumFractionDigits:2
});
function localDateString(){
  const d = new Date();
  const local = new Date(d.getTime() - d.getTimezoneOffset()*60000);
  return local.toISOString().slice(0,10);
}
function setMessage(message, type="secondary"){
  $("msg").className = "status text-" + type;
  $("msg").textContent = message;
}
function show(view){
  $("viewHome").classList.toggle("hidden", view !== "home");
  $("viewExpense").classList.toggle("hidden", view !== "expense");
}
function apiReady(){
  return API_URL && API_URL.startsWith("https://script.google.com/macros/s/") && API_URL.endsWith("/exec");
}
async function requestJson(url, options){
  const response = await fetch(url, options);
  if(!response.ok) throw new Error("Server returned HTTP " + response.status);
  const data = await response.json();
  if(data.ok === false) throw new Error(data.error || "Server error");
  return data;
}
async function apiList(){
  if(!apiReady()) throw new Error("Google Apps Script URL belum dimasukkan dalam index.html.");
  const data = await requestJson(API_URL + "?department=" + encodeURIComponent(dept));
  return Array.isArray(data.rows) ? data.rows : [];
}
async function apiSave(entry){
  if(!apiReady()) throw new Error("Google Apps Script URL belum dimasukkan dalam index.html.");
  await requestJson(API_URL, {
    method:"POST",
    headers:{"Content-Type":"text/plain;charset=utf-8"},
    body:JSON.stringify(entry)
  });
}
function normalizeDate(value){
  if(value instanceof Date) return value.toISOString().slice(0,10);
  return String(value ?? "").slice(0,10);
}
function groupTransactions(rows){
  // New records share a transactionId. Legacy records are paired when adjacent
  // rows have matching date, department, description and amount.
  const groups = [];
  const byId = new Map();
  for(let i=0;i<rows.length;i++){
    const row = rows[i];
    const id = row.transactionId || row.transaction_id;
    if(id){
      if(!byId.has(id)){ byId.set(id, groups.length); groups.push([]); }
      groups[byId.get(id)].push(row);
      continue;
    }
    const previous = groups[groups.length-1];
    const amount = Number(row.debit || row.credit || 0);
    const prevAmount = previous?.length ? Number(previous[0].debit || previous[0].credit || 0) : -1;
    const previousRow = previous?.[0];
    const canPair = previous && previous.length === 1 &&
      normalizeDate(previousRow.date) === normalizeDate(row.date) &&
      String(previousRow.department || "") === String(row.department || "") &&
      String(previousRow.description || "") === String(row.description || "") &&
      amount === prevAmount && Number(row.debit || 0) !== Number(previousRow.debit || 0);
    if(canPair) previous.push(row);
    else groups.push([row]);
  }
  return groups;
}
function renderRows(rows){
  const selected = rows.filter(r => !r.department || r.department === dept);
  const groups = groupTransactions(selected);
  // API returns sheet order (oldest first); reverse groups, never individual lines.
  const recent = groups.slice(-10).reverse();
  if(!recent.length){
    $("rows").innerHTML = '<tr><td colspan="5" class="text-center text-secondary py-3">No entries yet.</td></tr>';
    return;
  }
  const html = [];
  recent.forEach(group => {
    const ordered = [...group].sort((a,b) => {
      const aDebit = Number(a.debit || 0) > 0 ? 0 : 1;
      const bDebit = Number(b.debit || 0) > 0 ? 0 : 1;
      return aDebit - bDebit;
    });
    ordered.forEach((r,index) => {
      html.push(`<tr class="${index===0 ? "transaction-start" : "transaction-credit"}">
        <td>${esc(normalizeDate(r.date))}</td>
        <td>${esc(r.description)}</td>
        <td>${esc(r.account)}</td>
        <td class="num amount-cell">${Number(r.debit||0)>0 ? money(r.debit) : ""}</td>
        <td class="num amount-cell">${Number(r.credit||0)>0 ? money(r.credit) : ""}</td>
      </tr>`);
    });
  });
  $("rows").innerHTML = html.join("");
}
async function loadRows(){
  $("rows").innerHTML = '<tr><td colspan="5" class="text-center text-secondary py-3">Loading…</td></tr>';
  try{
    const rows = await apiList();
    renderRows(rows);
  }catch(err){
    $("rows").innerHTML = `<tr><td colspan="5" class="text-danger py-3">${esc(err.message)}</td></tr>`;
  }
}
$("deptSelect").addEventListener("change", async e => {
  dept = e.target.value;
  $("deptName").textContent = dept;
  $("fDate").value = localDateString();
  setMessage("");
  show("expense");
  await loadRows();
});
$("btnBack").addEventListener("click", () => {
  $("deptSelect").selectedIndex = 0;
  show("home");
});
$("expenseForm").addEventListener("submit", async e => {
  e.preventDefault();
  const amountRaw = $("fAmount").value.trim();
  const amount = Number(amountRaw);
  if(!Number.isFinite(amount) || amount <= 0 || amount > MAX_AMOUNT){
    setMessage("Please enter an amount between RM0.01 and RM99,999,999.99.","danger");
    $("fAmount").focus();
    return;
  }
  if(!Number.isInteger(Math.round(amount*100))){
    setMessage("Amount must be valid to 2 decimal places.","danger");
    return;
  }
  const entry = {
    date:$("fDate").value,
    department:dept,
    description:$("fDesc").value.trim(),
    account:$("fAccount").value,
    payAccount:$("fPay").value,
    amount:Number(amount.toFixed(2))
  };
  if(!entry.date || !entry.description || !entry.department){
    setMessage("Please complete all required fields.","danger");
    return;
  }
  if(entry.account === entry.payAccount){
    setMessage("Debit and Credit accounts cannot be the same.","danger");
    return;
  }
  const btn = $("btnSave");
  btn.disabled = true;
  setMessage("Saving to Google Sheets…");
  try{
    await apiSave(entry);
    setMessage("Saved successfully. Debit " + entry.account + " / Credit " + entry.payAccount + ".","success");
    $("fDesc").value = "";
    $("fAmount").value = "";
    await loadRows();
  }catch(err){
    setMessage("Could not save: " + err.message,"danger");
  }finally{
    btn.disabled = false;
  }
});
$("btnCsv").addEventListener("click", async () => {
  try{
    if(!apiReady()) throw new Error("Google Apps Script URL belum dimasukkan.");
    const data = await requestJson(API_URL + "?all=1");
    const rows = Array.isArray(data.rows) ? data.rows : [];
    if(!rows.length){ alert("No entries to download yet."); return; }
    const quote = v => '"' + String(v ?? "").replace(/"/g,'""') + '"';
    const header = ["Date","Department","Description","Account","Debit","Credit"];
    const lines = [header.map(quote).join(",")].concat(rows.map(r =>
      [normalizeDate(r.date),r.department,r.description,r.account,r.debit||0,r.credit||0].map(quote).join(",")
    ));
    const blob = new Blob(["\uFEFF"+lines.join("\r\n")],{type:"text/csv;charset=utf-8"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = "adibah-journal.csv"; a.click();
    URL.revokeObjectURL(url);
  }catch(err){ alert("Could not download: " + err.message); }
});
$("connectionStatus").textContent = apiReady()
  ? "Google Sheets connection configured."
  : "Setup required: connect Google Apps Script before using the ledger.";
</script>
</body>
</html>
